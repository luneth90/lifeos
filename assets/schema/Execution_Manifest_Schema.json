{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://lifeos.dev/schema/execution-manifest-v1.json",
	"title": "LifeOS Execution Manifest",
	"type": "object",
	"required": [
		"contract_version",
		"run_id",
		"phase",
		"plan_revision",
		"confirmed_hash",
		"inputs",
		"artifacts",
		"status_mutations",
		"validation",
		"errors"
	],
	"properties": {
		"contract_version": { "const": 1 },
		"run_id": { "type": "string", "minLength": 1 },
		"phase": {
			"type": "string",
			"enum": ["planned", "confirmed", "executing", "validated", "committed", "failed", "cancelled"]
		},
		"plan_revision": { "type": "integer", "minimum": 1 },
		"confirmed_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
		"inputs": { "type": "object" },
		"artifacts": { "type": "array", "items": { "type": "object" } },
		"status_mutations": { "type": "array", "items": { "type": "object" } },
		"validation": { "type": "array", "items": { "type": "object" } },
		"errors": { "type": "array", "items": { "type": "object" } }
	},
	"additionalProperties": false
}
