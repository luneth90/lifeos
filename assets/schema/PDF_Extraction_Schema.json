{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://lifeos.dev/schema/pdf-extraction-v2.json",
	"title": "LifeOS PDF Extraction Package",
	"type": "object",
	"required": [
		"schema_version",
		"source",
		"extractor",
		"requested_range",
		"requested_pages",
		"pages",
		"summary"
	],
	"properties": {
		"schema_version": { "const": 2 },
		"source": {
			"type": "object",
			"required": ["path", "sha256", "mtime", "page_count"],
			"properties": {
				"path": {
					"type": "string",
					"minLength": 1,
					"pattern": "^(?!\\s)(?!.*\\s$)(?!/)(?!~/)(?!.*:)(?!.*//)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*/$)[^:\\\\\\u0000-\\u001f]+$",
					"description": "安全的 Vault 相对显示标签；默认仅为源 PDF 文件名，不得包含本机绝对路径"
				},
				"sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
				"mtime": { "type": "string", "format": "date-time" },
				"page_count": { "type": "integer", "minimum": 1 }
			},
			"additionalProperties": false
		},
		"extractor": {
			"type": "object",
			"required": ["name", "version"],
			"properties": {
				"name": { "const": "lifeos-read-pdf" },
				"version": { "const": "2" }
			},
			"additionalProperties": false
		},
		"requested_range": {
			"type": "object",
			"required": ["start", "end"],
			"properties": {
				"start": { "type": "integer", "minimum": 1 },
				"end": { "type": "integer", "minimum": 1 }
			},
			"additionalProperties": false
		},
		"requested_pages": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": { "type": "integer", "minimum": 1 }
		},
		"pages": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": [
					"pdf_page_index",
					"printed_page_label",
					"page_size",
					"status",
					"coverage",
					"confidence",
					"errors",
					"blocks"
				],
				"properties": {
					"pdf_page_index": { "type": "integer", "minimum": 1 },
					"printed_page_label": { "type": ["string", "null"] },
					"page_size": {
						"type": "object",
						"required": ["width", "height"],
						"properties": {
							"width": { "type": "number", "minimum": 0 },
							"height": { "type": "number", "minimum": 0 }
						},
						"additionalProperties": false
					},
					"status": { "enum": ["complete", "needs_ocr", "partial", "failed"] },
					"coverage": { "type": "number", "minimum": 0, "maximum": 1 },
					"confidence": { "type": "number", "minimum": 0, "maximum": 1 },
					"errors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
					"blocks": {
						"type": "array",
						"items": {
							"type": "object",
							"required": ["kind", "order", "content", "bbox"],
							"properties": {
								"kind": { "enum": ["text", "image"] },
								"order": { "type": "integer", "minimum": 1 },
								"content": { "type": "string" },
								"bbox": {
									"type": "object",
									"required": ["x0", "y0", "x1", "y1"],
									"properties": {
										"x0": { "type": "number", "minimum": 0 },
										"y0": { "type": "number", "minimum": 0 },
										"x1": { "type": "number", "minimum": 0 },
										"y1": { "type": "number", "minimum": 0 }
									},
									"additionalProperties": false
								}
							},
							"additionalProperties": false
						}
					}
				},
				"additionalProperties": false
			}
		},
		"summary": {
			"type": "object",
			"required": ["complete_pages", "needs_ocr_pages", "partial_pages", "failed_pages"],
			"properties": {
				"complete_pages": { "type": "integer", "minimum": 0 },
				"needs_ocr_pages": { "type": "integer", "minimum": 0 },
				"partial_pages": { "type": "integer", "minimum": 0 },
				"failed_pages": { "type": "integer", "minimum": 0 }
			},
			"additionalProperties": false
		},
		"rendered_images": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["page", "path"],
				"properties": {
					"page": { "type": "integer", "minimum": 1 },
					"path": { "type": "string", "minLength": 1 }
				},
				"additionalProperties": false
			}
		}
	},
	"additionalProperties": false
}
